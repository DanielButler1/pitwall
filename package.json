{
	"name": "pitwall-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Formula 1 statistics, records and what-if universes, from 1950 to today: the website (apps/web), the mobile app (apps/mobile) and their shared logic (packages/core).",
	"license": "PolyForm-Noncommercial-1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/DanielButler1/pitwall"
	},
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@10.15.1",
	"scripts": {
		"dev": "pnpm --filter @pitwall/web dev",
		"build": "pnpm --filter @pitwall/web build",
		"data": "pnpm --filter @pitwall/web data",
		"data:update": "pnpm --filter @pitwall/web data:update",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test"
	}
}
