{
	"name": "pitwall",
	"version": "1.0.0",
	"private": true,
	"description": "Formula 1 statistics, records and what-if universes, from 1950 to today.",
	"license": "PolyForm-Noncommercial-1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/DanielButler1/pitwall"
	},
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@10.15.1",
	"scripts": {
		"data": "node scripts/prepare-data.mjs --force",
		"data:check": "node scripts/check-data-updates.mjs",
		"data:update": "node scripts/check-data-updates.mjs && node scripts/prepare-data.mjs",
		"predev": "node scripts/prepare-data.mjs && node scripts/ensure-client-data.mjs",
		"dev": "next dev",
		"build": "node scripts/prepare-data.mjs --force && next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"flag-icons": "^7.6.0",
		"idb": "^8.0.3",
		"lucide-react": "^1.17.0",
		"next": "16.3.6",
		"next-themes": "^0.4.6",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"fflate": "^0.8.3",
		"shadcn": "^4.12.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6"
	}
}
