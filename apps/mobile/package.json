{
	"name": "@pitwall/mobile",
	"version": "0.1.0",
	"private": true,
	"description": "The Pitwall mobile app (Expo). Builds every screen on the device from the shared @pitwall/core logic and the site's dataset.",
	"license": "PolyForm-Noncommercial-1.0.0",
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start --dev-client",
		"start": "expo start --dev-client",
		"android": "expo run:android",
		"prebuild": "expo prebuild --platform android --clean",
		"apk": "node scripts/build-apk.mjs",
		"deploy": "node scripts/deploy.mjs",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"doctor": "expo-doctor"
	},
	"dependencies": {
		"@expo/metro-runtime": "~58.0.14",
		"@legendapp/list": "^3.6.0",
		"@pitwall/core": "workspace:*",
		"@tanstack/react-query": "5.101.4",
		"clsx": "^2.1.1",
		"expo": "~58.0.14",
		"expo-build-properties": "~58.0.4",
		"expo-constants": "~58.0.12",
		"expo-dev-client": "~58.0.14",
		"expo-file-system": "~58.0.9",
		"expo-font": "~58.0.8",
		"expo-haptics": "~58.0.7",
		"expo-linking": "~58.0.13",
		"expo-navigation-bar": "~58.0.4",
		"expo-router": "~58.0.23",
		"expo-splash-screen": "~58.0.10",
		"expo-sqlite": "~58.0.13",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"fflate": "^0.8.3",
		"lucide-react-native": "^0.548.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"tailwind-merge": "^3.5.0",
		"uniwind": "1.12.2"
	},
	"devDependencies": {
		"@types/node": "^26",
		"@types/react": "19.2.17",
		"eslint": "^9.39.5",
		"eslint-config-expo": "~58.0.4",
		"tailwindcss": "^4.3.2",
		"typescript": "^6"
	},
	"expo": {
		"doctor": {
			"reactNativeDirectoryCheck": {
				"listUnknownPackages": false
			}
		}
	}
}
